# =============================================================================
# facebook-clone — backend environment
# -----------------------------------------------------------------------------
# Copy to .env and adjust. Values here match docker-compose.yml so the stack
# boots with zero changes.
# =============================================================================
APP_NAME="Facebook Clone"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=UTC
APP_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ------------------------------------------------------------------ database
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=facebook_clone
DB_USERNAME=facebook
DB_PASSWORD=secret

# Read replica (set DB_READ_HOST=mysql to disable splitting)
DB_READ_HOST=mysql-repl
DB_READ_PORT=3306

# --------------------------------------------------------------------- redis
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_DB=2
REDIS_PRESENCE_DB=3

CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=43200
QUEUE_CONNECTION=redis

# --------------------------------------------------------------- broadcasting
BROADCAST_DRIVER=pusher
PUSHER_APP_ID=facebook
PUSHER_APP_KEY=facebook-key
PUSHER_APP_SECRET=facebook-secret
PUSHER_HOST=soketi
PUSHER_PORT=6001
PUSHER_SCHEME=http

# Vite dev server + production origin (Sanctum stateful domains)
SANCTUM_STATEFUL_DOMAINS="localhost:5173,127.0.0.1:5173,localhost,127.0.0.1"

# --------------------------------------------------------------------- search
SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_KEY=masterKeyChangeMe

# ----------------------------------------------------------------------- mail
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM_ADDRESS="no-reply@facebook-clone.test"
MAIL_FROM_NAME="Facebook Clone"

# ---------------------------------------------------------------------- media
FILESYSTEM_DISK=public
MEDIA_DISK=s3
AWS_ACCESS_KEY_ID=facebook
AWS_SECRET_ACCESS_KEY=facebooksecret
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=facebook-clone
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# ---------------------------------------------------------------- news feed
# How far back the candidate generator looks for posts, and how long a
# pre-computed feed stays cached in Redis (minutes).
FEED_LOOKBACK_DAYS=7
FEED_CACHE_TTL=15
FEED_CANDIDATE_LIMIT=500
FEED_PAGE_SIZE=10
FEED_CHRONOLOGICAL_PAGE_SIZE=20

# ------------------------------------------------------------ auth hardening
AUTH_MAX_LOGIN_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
SANCTUM_TOKEN_EXPIRATION=43200
