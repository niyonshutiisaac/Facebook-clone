# Base URL of the Laravel API (use /api in dev so Vite proxies it).
VITE_API_URL=/api

# Real-time transport. `null` disables websockets and keeps the app on polling.
VITE_BROADCAST_DRIVER=null

# Soketi / Pusher credentials (only needed when the driver is not `null`).
VITE_PUSHER_KEY=app-key
VITE_PUSHER_HOST=localhost
VITE_PUSHER_PORT=6001
VITE_PUSHER_SCHEME=http

# Force the mock adapter even if an API is reachable (useful for UI work).
VITE_USE_MOCKS=true
